    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "User story"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "As a V4 user, I want to move between the launcher, API Request Audit and GIS without losing access to the available modules."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Scope and setup"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Start at https://o2intelligence-v4-dev.metricell.com/launcher using authorised V4 access. Use only normal UI controls. Navigation only: do not edit records, change audit filters or add layers. Record actual browser-derived destination URLs; metric values may vary."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance criteria"
            }
          ]
        },
        {
          "type": "orderedList",
          "attrs": {
            "order": 1
          },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The authorised launcher visibly provides GIS and API Request Audit module cards and their Open controls."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Opening API Request Audit displays identifiable audit content, such as request metrics or the Requests and errors over time chart, rather than a sign-in or application error page."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Browser Back returns to the launcher with GIS available. Opening GIS from that returned launcher displays a settled map with map controls."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Evidence and cleanup"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Capture the relevant before/after state for each journey, including the returned launcher immediately before opening GIS. Finish on the launcher without changing pre-existing application data."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "User-guide relevance"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Assess existing module-navigation guidance. Update it only if the verified workflow reveals a material gap; do not add a duplicate section just because this test passed."
            }
          ]
        }
      ]
    },
