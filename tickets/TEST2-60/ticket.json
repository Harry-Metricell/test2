  "fields": {
    "summary": "Keep a changed Show linked sites state when closing and reopening GIS Display Settings",
    "subtasks": [],
    "created": "2026-10-06T17:52:26.710+0100",
    "project": {
      "self": "https://metricell.atlassian.net/rest/api/3/project/10551",
      "id": "10551",
      "key": "TEST2",
      "name": "testing board",
      "projectTypeKey": "business",
      "simplified": true,
      "avatarUrls": {
        "48x48": "https://metricell.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10400",
        "24x24": "https://metricell.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10400?size=small",
        "16x16": "https://metricell.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10400?size=xsmall",
        "32x32": "https://metricell.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10400?size=medium"
      }
    },
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Verify persistence of a deliberately changed setting within the current session, not merely persistence of the default."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Environment: https://o2intelligence-v4-dev.metricell.com/launcher. Use existing authorised access, open GIS and load one test-created Surveyor layer using its defaults. Record the layer identity and Show linked sites initial state. Do not change saved records or other users' layers."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Acceptance criteria"
            }
          ]
        },
        {
          "type": "orderedList",
          "attrs": {
            "order": 1
          },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Display Settings for the test-created Surveyor layer shows an identifiable initial Show linked sites checkbox state."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Changing Show linked sites once visibly changes it to the opposite state, without adding another layer."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "After changing it to the opposite state, closing and reopening Display Settings for the same layer shows the changed state, not the original; the layer remains loaded."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Changing it back to the recorded original state and closing/reopening Display Settings again shows the original state, with the same layer still loaded."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Each comparison must have its own ordered before/change/reopen evidence and identify the same layer. Scope is checkbox state in one browser session, not linked-site data correctness or reload/login persistence. Restore the original checkbox and remove only the test-created layer during cleanup."
            }
          ]
        }
      ]
    },
    "assignee": null,
