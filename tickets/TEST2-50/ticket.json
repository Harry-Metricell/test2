  "fields": {
    "summary": "Confirm Show linked sites can be changed and restored in V4 GIS Display Settings",
    "subtasks": [],
    "created": "2026-10-02T14:20:40.951+0100",
    "project": {
      "self": "https://metricell.atlassian.net/rest/api/3/project/10551",
