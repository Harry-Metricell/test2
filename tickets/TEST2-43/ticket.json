    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Read-only V4 navigation check. Start at https://o2intelligence-v4-dev.metricell.com/launcher in an authenticated browser. Select the Dashboards card's Open module control, then use the browser Back control to return to the launcher. Do not create, edit, or delete any data."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Acceptance criteria:"
            }
          ]
        },
        {
          "type": "orderedList",
          "attrs": {
            "order": 1
          },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The launcher shows the Dashboards card and its Open module control."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Selecting Open module on the Dashboards card displays the Dashboards module or its current placeholder without an application error."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Browser Back returns to the launcher, where the Dashboards card is visible again."
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
