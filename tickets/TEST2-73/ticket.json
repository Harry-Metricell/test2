    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "User story"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "As a V4 GIS user, I want to clear a layer search that returns no matches so I can browse the available layers again without changing my map."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Test scope"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Use https://o2intelligence-v4-dev.metricell.com/launcher and open the GIS module. Authenticate normally if prompted. Use the existing layer catalogue search; this is a read-only UI test, not a request to create data or change configuration. Record the initial catalogue, visible map and active-layer state before searching. Enter a distinctive unmatched query such as TEST2-showcase-no-match-20261012. Clear it using the available search control, then leave the page in its original state."
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Acceptance criteria"
            }
          ]
        },
        {
          "type": "orderedList",
          "attrs": {
            "order": 1
          },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Entering an unmatched query in the GIS layer catalogue search filters out unrelated catalogue entries; the entered query remains visible and the interface does not present unrelated layers as matches."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Clearing the query restores the initial catalogue contents and browsing controls. Compare the same catalogue position before and after clearing, including any scrolling needed to establish that the original entries have returned."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Searching and clearing do not change the initially active layers or visible map state. The final query is empty and the catalogue, map and active-layer state match the recorded initial state."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "heading",
          "attrs": {
            "level": 2
          },
          "content": [
            {
              "type": "text",
              "text": "Evidence expectations"
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Capture readable, URL-attributed evidence for the initial state, unmatched search, and restored state. Keep before/after views comparable and associate each acceptance criterion with its decisive evidence. Report genuine access or application failures honestly; do not infer success from missing evidence."
            }
          ]
        }
      ]
    },
