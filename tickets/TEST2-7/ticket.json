    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "As a user, I need to control the GIS map display after opening the GIS module."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Open GIS from the V4 launcher. The GIS workspace should load with the map and its controls visible."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Open the map layer control and enable an available coverage or network layer. The selected layer should become visible on the map."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Use the zoom-in control to enlarge the map view. The map should visibly change scale while remaining centred on the current area."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Use the reset map view control. The map should return to its default view and the GIS controls should remain usable."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Open the map style control and select another available style. The map appearance should change, and the style control should remain available for further use."
            }
          ]
        }
      ]
    },
    "assignee": null,
