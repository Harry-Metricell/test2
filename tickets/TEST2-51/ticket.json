      "simplified": true,
      "avatarUrls": {
        "48x48": "https://metricell.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10400",
        "24x24": "https://metricell.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10400?size=small",
        "16x16": "https://metricell.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10400?size=xsmall",
        "32x32": "https://metricell.atlassian.net/rest/api/3/universal_avatar/view/type/project/avatar/10400?size=medium"
      }
    },
    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Users should be able to close and reopen a Surveyor layer's Display Settings without removing the layer or changing the Show linked sites selection merely by opening or closing the panel."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Environment: https://o2intelligence-v4-dev.metricell.com/ . Open GIS from the launcher with existing authorised access and load an available Surveyor layer using its default configuration."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Acceptance criteria"
            }
          ]
        },
        {
          "type": "orderedList",
          "attrs": {
            "order": 1
          },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "After the Surveyor layer is loaded, its layer legend shows the layer name and a Display Settings control."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Opening Display Settings displays Show linked sites with a clearly identifiable checked or unchecked state."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Closing Display Settings dismisses the settings panel while the same Surveyor layer remains in the layer list and its legend remains available."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Reopening Display Settings for that same layer displays Show linked sites in the same state observed before closing it, without requiring the layer to be added again."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Scope: do not change the checkbox or assert persistence across a page reload or new login session. Do not edit backend data. If a layer was added solely for this test, remove it after evidence collection; this is test cleanup, not a user-guide step."
            }
          ]
        }
      ]
    },
