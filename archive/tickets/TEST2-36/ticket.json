      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Small V4 interaction regression test. Start at https://o2intelligence-v4-dev.metricell.com/launcher and sign in if prompted. Open GIS. Do not change saved data or layers."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Acceptance criteria:"
            }
          ]
        },
        {
          "type": "orderedList",
          "attrs": {
            "order": 1
          },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The GIS page displays a usable base map and visible map controls without an application error."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Dragging the map changes the visible geographic area while the GIS page remains open."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "After panning, the map controls remain visible and usable, and the page shows no application error."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Capture browser evidence before and after the pan, including the final browser URL."
            }
          ]
        }
      ]
    },
