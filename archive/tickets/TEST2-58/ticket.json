  "fields": {
    "summary": "Cancel a second Surveyor layer configuration without disturbing an existing loaded layer",
    "subtasks": [],
    "created": "2026-10-06T15:46:59.368+0100",
    "project": {
      "self": "https://metricell.atlassian.net/rest/api/3/project/10551",
