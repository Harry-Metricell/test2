    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Small V4 navigation and reload regression test. Start at https://o2intelligence-v4-dev.metricell.com/launcher and sign in if prompted. Open the Dashboards card. This checks only the current placeholder; creating dashboards or data is out of scope."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Acceptance criteria:"
            }
          ]
        },
        {
          "type": "orderedList",
          "attrs": {
            "order": 1
          },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Opening Dashboards from the launcher displays the Dashboards page at https://o2intelligence-v4-dev.metricell.com/dashboards with its Under construction message and Back to Launcher button."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Reloading that page leaves the Dashboards placeholder usable: the Under construction message and Back to Launcher button remain visible without an application error."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Selecting Back to Launcher returns to https://o2intelligence-v4-dev.metricell.com/launcher, where the Dashboards card is visible."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Capture browser evidence of the page after reload and after returning."
            }
          ]
        }
      ]
    },
