    "description": {
      "type": "doc",
      "version": 1,
      "content": [
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Small regression test for launcher-to-GIS navigation on the V4 development site."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Test from https://o2intelligence-v4-dev.metricell.com/launcher. Sign in if prompted."
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "Acceptance criteria:"
            }
          ]
        },
        {
          "type": "orderedList",
          "attrs": {
            "order": 1
          },
          "content": [
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "The V4 launcher displays a GIS module card with an enabled Open GIS control."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Selecting Open GIS navigates to https://o2intelligence-v4-dev.metricell.com/gis and displays the GIS page without an application error."
                    }
                  ]
                }
              ]
            },
            {
              "type": "listItem",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Using the browser Back button returns to https://o2intelligence-v4-dev.metricell.com/launcher, where the GIS card is visible again."
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "paragraph",
          "content": [
            {
              "type": "text",
              "text": "This ticket tests navigation only; it does not require map-layer or zoom functionality."
            }
          ]
        }
      ]
    },
